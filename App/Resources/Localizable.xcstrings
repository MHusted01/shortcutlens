{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ did not quit. Quit it yourself and open it again." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ blev ikke afsluttet. Afslut den selv, og åbn den igen."
          }
        }
      }
    },
    "%@ has no bundle identifier, so progress is not saved." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har intet bundle-id, så fremskridt gemmes ikke."
          }
        }
      }
    },
    "%@ has no bundle identifier." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har intet bundle-id."
          }
        }
      }
    },
    "%@ has no menu shortcuts to practise." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har ingen menugenveje at øve."
          }
        }
      }
    },
    "%@ is sandboxed. macOS does not let ShortcutLens edit its App Shortcuts." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kører i en sandkasse. macOS lader ikke ShortcutLens redigere dens appgenveje."
          }
        }
      }
    },
    "%@ quit but could not be opened again." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ blev afsluttet, men kunne ikke åbnes igen."
